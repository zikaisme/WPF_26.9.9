<Window x:Class="WPF_26._9._9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_26._9._9"
        mc:Ignorable="d"
        Title="WPF飲料訂購ver2" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="638*"/>
            <ColumnDefinition Width="162*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. 頂部：內用 / 外帶 -->
        <GroupBox Header="內用/外帶" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
            <StackPanel Orientation="Horizontal" Background="#FFE4C4" Height="36" VerticalAlignment="Center">
                <RadioButton Content="內用" IsChecked="True" FontSize="14" Margin="50,0,30,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <RadioButton Content="外帶" FontSize="14" Margin="30,0,30,0" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. 中間左側：飲料選單列表 (每項之間有垂直間隔 Margin="5,3,5,3") -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="0,5,0,0">

            <!-- 項目 1：紅茶大杯 -->
            <StackPanel Orientation="Horizontal" Height="36" Margin="5,3,5,3" Background="Beige">
                <CheckBox Content="紅茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="50,0,0,0"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                <Slider x:Name="slider1" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Label Content="{Binding Value, ElementName=slider1}" ContentStringFormat="{}{0:0}" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 項目 2：紅茶小杯 -->
            <StackPanel Orientation="Horizontal" Height="36" Margin="5,3,5,3" Background="Beige">
                <CheckBox Content="紅茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="50,0,0,0"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                <Slider x:Name="slider2" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Label Content="{Binding Value, ElementName=slider2}" ContentStringFormat="{}{0:0}" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 項目 3：奶茶大杯 -->
            <StackPanel Orientation="Horizontal" Height="36" Margin="5,3,5,3" Background="Beige">
                <CheckBox Content="奶茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="50,0,0,0"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                <Slider x:Name="slider3" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Label Content="{Binding Value, ElementName=slider3}" ContentStringFormat="{}{0:0}" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 項目 4：奶茶小杯 -->
            <StackPanel Orientation="Horizontal" Height="36" Margin="5,3,5,3" Background="Beige">
                <CheckBox Content="奶茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="50,0,0,0"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                <Slider x:Name="slider4" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Label Content="{Binding Value, ElementName=slider4}" ContentStringFormat="{}{0:0}" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 項目 5：綠茶大杯 -->
            <StackPanel Orientation="Horizontal" Height="36" Margin="5,3,5,3" Background="Beige">
                <CheckBox Content="綠茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="50,0,0,0"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                <Slider x:Name="slider5" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Label Content="{Binding Value, ElementName=slider5}" ContentStringFormat="{}{0:0}" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 項目 6：綠茶小杯 -->
            <StackPanel Orientation="Horizontal" Height="36" Margin="5,3,5,3" Background="Beige">
                <CheckBox Content="綠茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="50,0,0,0"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                <Slider x:Name="slider6" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Label Content="{Binding Value, ElementName=slider6}" ContentStringFormat="{}{0:0}" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

        </StackPanel>

        <!-- 3. 中間右側：訂購按鈕 (已綁定 Click 事件) -->
        <Button x:Name="btnOrder" Content="訂購" Grid.Row="1" Grid.Column="1" 
                Width="100" Height="60" FontSize="18" 
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Click="btnOrder_Click"/>

        <!-- 4. 底部：訂購結果顯示區 (淡黃色背景) -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#FAF8CD" Margin="5">
            <TextBox x:Name="txtResult" Background="Transparent" BorderThickness="0" 
                     FontSize="14" Padding="10" IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
        </Border>

    </Grid>
</Window>